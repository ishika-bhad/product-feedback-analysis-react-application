# Stage 1: Build React Frontend
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package config and install dependencies
COPY react/package.json react/package-lock.json* ./
RUN npm install

# Copy frontend source code
COPY react/ ./

# Pass an empty VITE_API_URL so Axios uses relative paths (/api) 
# which will be caught and proxy-passed by NGINX.
ENV VITE_API_URL=""
# Fallback hardcoded token for demo purposes. 
ENV VITE_API_BEARER_TOKEN="supersecrettoken1234567890"

# Build static files
RUN npm run build

# Stage 2: Serve with NGINX
FROM nginx:alpine

# Copy built assets to NGINX root
COPY --from=builder /app/dist /usr/share/nginx/html

# Overwrite default config with custom one
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
